# Megallm API Configuration
# Get your API key from https://megallm.io
MEGALLM_API_KEY=your_megallm_api_key_here
MEGALLM_API_URL=https://ai.megallm.io/v1

# AI Model Selection (Free tier models)
# Options: deepseek-r1-distill-llama-70b, gpt-oss, mistral-large, llama, qwen, kimi, k2, minimax
# Recommended: deepseek-r1-distill-llama-70b (best reasoning and structured output)
MEGALLM_MODEL=deepseek-r1-distill-llama-70b
